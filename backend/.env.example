# ==============================================================================
# AI SHORTS FACTORY & YOUTUBE MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Storage Directories (Relative to backend/ or Absolute paths)
OUTPUTS_DIR=./data/outputs
TEMP_CACHE_DIR=./data/temp
BRAND_KITS_DIR=./data/brand_kits

# Hardware Memory Guard Settings (Target: Windows / 16GB RAM / 4-6GB VRAM)
MAX_RAM_PERCENT_THRESHOLD=85.0
MAX_VRAM_MB_THRESHOLD=5500
FORCE_GC_AFTER_EACH_STAGE=True
UNLOAD_MODEL_AFTER_STAGE=True

# LLM Orchestrator Settings
# Options for LLM_PROVIDER: "ollama" | "openai" | "gemini"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=0s
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ==============================================================================
# 🔑 KHU VỰC CẤU HÌNH CÁC API KEYS
# ==============================================================================

# 1. API Kịch bản AI (Google Gemini - Khuyến nghị dùng, siêu tốc 1-2s)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 2. API Kho Video Dọc 4K (Pexels - Video flycam, drone, người thật 60fps)
# Đăng ký lấy API Key miễn phí 100% tại: https://www.pexels.com/api/
PEXELS_API_KEY=

# 3. API Kịch bản AI OpenAI (Tùy chọn)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 🎬 CẤU HÌNH ENGINE & BIÊN TẬP
# ==============================================================================
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW_PRESET=flux_schnell_fast
TTS_ENGINE_DEFAULT=edge_tts
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
TTS_SPEED_RATE=+22%
FFMPEG_PATH=ffmpeg

# Phase 3: YouTube Channel Manager
YOUTUBE_CLIENT_SECRETS_FILE=./data/client_secrets.json
YOUTUBE_SCOPES=["https://www.googleapis.com/auth/youtube.upload", "https://www.googleapis.com/auth/youtube.readonly", "https://www.googleapis.com/auth/yt-analytics.readonly"]

