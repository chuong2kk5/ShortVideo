# ==============================================================================
# Git Ignore - ShortVideo (AI Shorts Factory & Automation Suite)
# ==============================================================================

# Environment variables and API keys (CRITICAL: Do NOT commit!)
.env
*.env
!.env.example
.env.local
.env.*.local

# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database files
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite*
backend/data/*.db
backend/data/test_app.db

# Media outputs, temporary cache, and rendered videos
data/
backend/data/outputs/*
!backend/data/outputs/.gitkeep
backend/data/temp/*
!backend/data/temp/.gitkeep
backend/data/test_visual_verification/
assets/temp/
backend/*.mp3

# Node / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Windows shortcuts
*.lnk
